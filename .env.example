# Copy this to .env for local development. On Render, set these as
# Environment Variables in the service settings instead of a file.

# Supabase (or any Postgres) connection string.
# Get this from: Supabase project -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Any long random string — used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Set automatically by Render; only needed locally.
PORT=3000
NODE_ENV=production
